# Server-only Neon Postgres connection string (Vercel Project Settings -> Environment Variables)
DATABASE_URL=

# Server-only Razorpay test/live credentials. Never expose the secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Browser-visible Razorpay key ID only (public key, not the secret)
VITE_RAZORPAY_KEY_ID=

# Optional: configure to an independent random secret for direct JWT sessions
SKILLBRIDGE_SESSION_SECRET=
